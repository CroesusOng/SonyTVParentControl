<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Lets the TV reach http://<pi>:8080 before any TLS is set up, which is how
  you will want to test the first sideload. The release build has cleartext switched off.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
