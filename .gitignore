# Gradle / Android
.gradle/
build/
local.properties
*.apk
*.aab
*.keystore
!debug.keystore
captures/
.cxx/

# IDE
.idea/
*.iml
.kotlin/

# Go
server/braviaguardd
server/braviaguardd-*
server/dist/

# Runtime data (never commit a family's actual policy or usage)
server/data/
# House-specific deployment settings; only the .example belongs in git
braviaguard.env
.env
!braviaguard.env.example
!.env.example
*.pem
*.key
!web/**/*.key

# Xcode
# The .xcodeproj itself IS committed -- it is verified (it builds), and without it
# everyone has to recreate the target by hand. What is not committed is the per-user
# state Xcode drops inside it: window layout, breakpoints, which scheme was last run.
**/xcuserdata/
**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
DerivedData/

# macOS
.DS_Store
