# Plain systemd unit, for running the binary directly instead of in a container.
# Install to /etc/systemd/system/braviaguard.service
#
#   sudo useradd --system --home /var/lib/braviaguard --shell /usr/sbin/nologin braviaguard
#   sudo install -o braviaguard -g braviaguard -d /var/lib/braviaguard
#   sudo install -m755 braviaguardd /usr/local/bin/braviaguardd
#   sudo install -d -m700 /etc/braviaguard
#   sudo install -m600 braviaguard.env.example /etc/braviaguard/braviaguard.env
#   sudoedit /etc/braviaguard/braviaguard.env
#   sudo systemctl enable --now braviaguard

[Unit]
Description=BraviaGuard parental control backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=braviaguard
Group=braviaguard
ExecStart=/usr/local/bin/braviaguardd
Restart=always
RestartSec=5

# Everything house-specific lives here and is not in git. Copy
# braviaguard.env.example to this path and edit it before the first start.
EnvironmentFile=/etc/braviaguard/braviaguard.env

# It reads certificates and writes one directory. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/braviaguard
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
