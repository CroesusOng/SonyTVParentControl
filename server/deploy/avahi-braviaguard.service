<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Install to /etc/avahi/services/braviaguard.service on the Pi, then
  `sudo systemctl reload avahi-daemon`.

  This is what lets the TV app find the Pi by itself instead of making someone spell out
  a URL with a D-pad. The Go binary publishes nothing: a Raspberry Pi already runs
  avahi-daemon, so reusing it keeps an mDNS library out of the server. Keep <port> in
  step with BG_LISTEN.

  scheme=http is right whenever something in front terminates TLS (Cloudflare Tunnel,
  a reverse proxy): the televisions talk to this host directly on the LAN, in the
  clear, authenticated by a bearer token. Set it to https only when this process holds
  the certificate itself -- otherwise the TV builds an https:// URL for a port that
  speaks plain HTTP and discovery silently produces something that cannot connect.
-->
<service-group>
  <name replace-wildcards="yes">BraviaGuard on %h</name>
  <service>
    <type>_braviaguard._tcp</type>
    <port>8443</port>
    <txt-record>scheme=http</txt-record>
  </service>
</service-group>
