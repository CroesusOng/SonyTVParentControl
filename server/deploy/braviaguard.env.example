# Copy to /etc/braviaguard/braviaguard.env and fill in. Deliberately NOT in git: it
# holds the values specific to one house, and one of them must never change.
#
#   sudo install -d -m700 /etc/braviaguard
#   sudo install -m600 braviaguard.env.example /etc/braviaguard/braviaguard.env
#   sudoedit /etc/braviaguard/braviaguard.env
#
# Both deployment modes read this same file, which is why the container mounts the
# certificates at the same path the host uses.

# Exactly the address you open in Safari, scheme and port included -- and NO port when
# it is served on 443, because that is what the browser puts in the Origin header.
#   behind Cloudflare Tunnel:  https://tv.example.com
#   terminating TLS here:      https://tv.example.com:8443
# WebAuthn binds every passkey to this one origin: change it later and every passkey
# already registered stops working. Settle it before anyone registers.
BG_ORIGINS=https://tv.example.com

# state.json and usage.json live here.
BG_DATA_DIR=/var/lib/braviaguard

# Bind on all interfaces, not just loopback: cloudflared reaches it on localhost while
# the televisions reach it on the LAN address. Keeping TV traffic on the LAN means an
# ISP outage does not stop enforcement.
BG_LISTEN=:8443

# Day and week boundaries for budgets and curfews are computed in this zone.
BG_TZ=Asia/Shanghai

# Leave BOTH EMPTY when something in front terminates TLS (Cloudflare Tunnel, a reverse
# proxy). The server notices that the origins are https and still marks session cookies
# Secure. Fill them in only when this process terminates TLS itself. See docs/TLS.md.
BG_TLS_CERT=
BG_TLS_KEY=

# Optional. Unset means a fresh random code is printed on every start, which is the
# safer default; set it only if you want a stable one while setting things up.
#BG_SETUP_CODE=
