# Podman Quadlet unit. Install to one of:
#   rootless:  ~/.config/containers/systemd/braviaguard.container
#   rootful:   /etc/containers/systemd/braviaguard.container
# then:  systemctl --user daemon-reload && systemctl --user start braviaguard
#
# Settings come from /etc/braviaguard/braviaguard.env -- create it from
# braviaguard.env.example first. BG_ORIGINS in particular must be right before the
# first start: WebAuthn binds every passkey to one exact origin, and changing it later
# invalidates the passkeys already registered.

[Unit]
Description=BraviaGuard parental control backend
Documentation=file:///opt/bravia-parental-control/README.md
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/braviaguard:latest
ContainerName=braviaguard
AutoUpdate=local

# Host networking, deliberately. The televisions reach the Pi by its LAN address, and the
# host's avahi-daemon advertises the service on the same port — a bridged network would
# mean the advertised port and the reachable port could drift apart.
Network=host

Volume=braviaguard-data:/var/lib/braviaguard:Z
# Mounted at the same path the host uses, so one env file serves both this and the
# plain-systemd unit. Read-only: the server only ever reads the certificate.
Volume=/etc/braviaguard/certs:/etc/braviaguard/certs:ro,Z

# Everything house-specific lives here and is not in git. Copy
# braviaguard.env.example to this path and edit it before the first start.
EnvironmentFile=/etc/braviaguard/braviaguard.env

User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
