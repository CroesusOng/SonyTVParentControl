# Two stages: build a static binary, ship it on nothing.
#
# The result is a single-file image of a few megabytes with no shell, no package manager
# and no libc — on a box meant to run untouched for years, there is nothing in it to
# patch and nothing to exploit if the process is ever compromised.
#
# Build on the Pi:
#   podman build -t braviaguard:latest -f Containerfile .
# Or cross-build on a Mac and push the tar over (see scripts/build-server.sh).

FROM docker.io/library/golang:1.26-alpine AS build

WORKDIR /src
# Dependencies first so an edit to the Go source does not re-download the module cache.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG TARGETOS=linux
ARG TARGETARCH=arm64
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/braviaguardd ./cmd/braviaguardd

FROM scratch

COPY --from=build /out/braviaguardd /braviaguardd

# Numeric, because scratch has no /etc/passwd to look a name up in.
USER 10001:10001

EXPOSE 8443
VOLUME /var/lib/braviaguard

ENV BG_DATA_DIR=/var/lib/braviaguard \
    BG_LISTEN=:8443

ENTRYPOINT ["/braviaguardd"]
